<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Manapoint.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Manapoint.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
         Title="Manapoint"
         Icon="/Assets/icon.png"
        Width="{Binding Settings.PanelWidth}"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="{Binding Settings.PanelFont}"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border Background="{Binding Settings.PanelBrush}"
            CornerRadius="10"
            BorderBrush="{Binding Settings.PanelBorderBrush}"
            BorderThickness="1"
            Padding="13,11"
            PointerPressed="OnDragArea"
            PointerReleased="OnDragEnd">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="重新整理" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="最小化" Click="OnMinimize" />
                <MenuItem Header="設定…" Click="OnOpenSettings" />
                <Separator />
                <MenuItem Header="結束" Click="OnExit" />
            </ContextMenu>
        </Border.ContextMenu>

        <ItemsControl x:Name="CardsList" ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ProviderCardViewModel">
                    <!-- 橫向排列時鎖成面板寬，星號欄才有寬度依據；直向 NaN 自動撐滿 -->
                    <StackPanel Width="{Binding CardWidth}">

                    <!-- 精簡樣式：表格式一行一家，5h/7d/30d 各佔固定一欄，缺席留空才對得齊 -->
                    <StackPanel IsVisible="{Binding IsTextStyle}"
                                Spacing="2"
                                Margin="0,1,0,4">
                        <Grid ColumnDefinitions="Auto,*,*,*"
                              ColumnSpacing="4">
                            <Border Grid.Column="0" Width="14" Height="14"
                                    CornerRadius="3"
                                    Background="{Binding BadgeBackground}"
                                    VerticalAlignment="Center">
                                <Panel>
                                    <Path Data="{Binding BadgeIcon}"
                                          IsVisible="{Binding HasBadgeIcon}"
                                          Fill="{Binding BadgeForeground}"
                                          Stretch="Uniform"
                                          Width="9" Height="9"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BadgeText}"
                                               IsVisible="{Binding !HasBadgeIcon}"
                                               FontSize="7" FontWeight="Bold"
                                               Foreground="{Binding BadgeForeground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Panel>
                            </Border>

                            <!-- 取不到數字時的佔位，靠左貼 logo；與數字欄互斥，不會重疊 -->
                            <TextBlock Grid.Column="1"
                                       Text="—"
                                       IsVisible="{Binding HasNote}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding Note}"
                                       Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />

                            <StackPanel Grid.Column="1"
                                        IsVisible="{Binding HasRolling}"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Rolling.ShortLabel}"
                                           FontSize="9"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />
                                <TextBlock Text="{Binding Rolling.PercentText}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Rolling.FillBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        IsVisible="{Binding HasWeekly}"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Weekly.ShortLabel}"
                                           FontSize="9"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />
                                <TextBlock Text="{Binding Weekly.PercentText}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Weekly.FillBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        IsVisible="{Binding HasMonthly}"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Monthly.ShortLabel}"
                                           FontSize="9"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />
                                <TextBlock Text="{Binding Monthly.PercentText}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Monthly.FillBrush}" />
                            </StackPanel>

                        </Grid>

                        <TextBlock Text="{Binding Error}"
                                   IsVisible="{Binding HasError}"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   Foreground="#E08A8A" />
                    </StackPanel>

                    <!-- 其餘樣式：標題加逐條量表 -->
                    <StackPanel Spacing="6" Margin="0,0,0,4"
                                IsVisible="{Binding IsRowStyle}">

                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Width="17" Height="17"
                                    CornerRadius="4"
                                    Background="{Binding BadgeBackground}"
                                    VerticalAlignment="Center">
                                <Panel>
                                    <Path Data="{Binding BadgeIcon}"
                                          IsVisible="{Binding HasBadgeIcon}"
                                          Fill="{Binding BadgeForeground}"
                                          Stretch="Uniform"
                                          Width="10" Height="10"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BadgeText}"
                                               IsVisible="{Binding !HasBadgeIcon}"
                                               FontSize="8" FontWeight="Bold"
                                               Foreground="{Binding BadgeForeground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Panel>
                            </Border>
                            <TextBlock Text="{Binding Provider}"
                                       FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding #Root.DataContext.Settings.TextPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Error}"
                                   IsVisible="{Binding HasError}"
                                   FontSize="10"
                                   Foreground="#E08A8A"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Note}"
                                   IsVisible="{Binding HasNote}"
                                   FontSize="10"
                                   Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}"
                                   TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:UsageWindowViewModel">
                                    <Grid ColumnDefinitions="44,*,36,26" Margin="0,0,0,5">

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />

                                        <Border Grid.Column="1"
                                                IsVisible="{Binding IsSmooth}"
                                                Height="5" CornerRadius="2.5"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center"
                                                Margin="0,0,9,0"
                                                Background="{Binding TrackBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding UsedStar}" />
                                                    <ColumnDefinition Width="{Binding FreeStar}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        CornerRadius="2.5"
                                                        Background="{Binding FillBrush}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    IsVisible="{Binding IsSegmented}"
                                                    Orientation="Horizontal"
                                                    Spacing="3"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,9,0">
                                            <TextBlock Text="["
                                                       IsVisible="{Binding HasBrackets}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />
                                            <ItemsControl ItemsSource="{Binding Segments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:MeterSegmentViewModel">
                                                        <Border Width="{Binding Width}" Height="7"
                                                                CornerRadius="{Binding Radius}"
                                                                Background="{Binding Brush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="]"
                                                       IsVisible="{Binding HasBrackets}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AlertText}"
                                                       IsVisible="{Binding HasAlert}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding FillBrush}" />
                                            <TextBlock Text="{Binding PercentText}"
                                                       FontSize="10"
                                                       Foreground="{Binding #Root.DataContext.Settings.TextSecondaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ResetsInText}"
                                                   FontSize="9"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
