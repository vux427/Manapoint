<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Manapoint.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Manapoint.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="Manapoint"
        Width="248"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border Background="{Binding Settings.PanelBrush}"
            CornerRadius="10"
            BorderBrush="{Binding Settings.PanelBorderBrush}"
            BorderThickness="1"
            Padding="13,11"
            PointerPressed="OnDragArea">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="重新整理" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem Header="設定…" Click="OnOpenSettings" />
                <Separator />
                <MenuItem Header="結束" Click="OnExit" />
            </ContextMenu>
        </Border.ContextMenu>

        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ProviderCardViewModel">
                    <StackPanel Spacing="6" Margin="0,0,0,4">

                        <TextBlock Text="{Binding Provider}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{Binding #Root.DataContext.Settings.TextPrimaryBrush}" />

                        <TextBlock Text="{Binding Error}"
                                   IsVisible="{Binding HasError}"
                                   FontSize="10"
                                   Foreground="#D97070"
                                   TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:UsageWindowViewModel">
                                    <Grid ColumnDefinitions="42,*,32,28" Margin="0,0,0,5">

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />

                                        <Border Grid.Column="1"
                                                Height="5"
                                                CornerRadius="2.5"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center"
                                                Margin="0,0,9,0"
                                                Background="{Binding #Root.DataContext.Settings.TrackBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding UsedStar}" />
                                                    <ColumnDefinition Width="{Binding FreeStar}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        CornerRadius="2.5"
                                                        Background="{Binding #Root.DataContext.Settings.AccentBrush}" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PercentText}"
                                                   FontSize="10"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding #Root.DataContext.Settings.TextSecondaryBrush}" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ResetsInText}"
                                                   FontSize="9"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding #Root.DataContext.Settings.TextMutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
