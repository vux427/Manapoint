<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Manapoint.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Manapoint.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Manapoint 設定"
        Width="330"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.grip:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="18" Spacing="18">

        <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="顯示的訂閱" />
            <TextBlock Classes="hint" Text="拖曳左側握把可調整顯示順序，拖曳時會顯示插入位置。" />

            <ItemsControl x:Name="ProviderList"
                          ItemsSource="{Binding Providers}"
                          DragDrop.AllowDrop="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProviderToggleViewModel">
                        <Border Background="{Binding RowBackground}"
                                Opacity="{Binding RowOpacity}"
                                CornerRadius="6"
                                Padding="4,1"
                                DragDrop.AllowDrop="True">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid RowDefinitions="Auto,Auto,Auto">

                                <!-- 插入線：上面，高度 0/2 用過渡長出 -->
                                <Border Grid.Row="0"
                                        Height="{Binding InsertBeforeHeight}"
                                        CornerRadius="1"
                                        Margin="26,0,2,0"
                                        Background="{Binding InsertionBrush}">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Height" Duration="0:0:0.15" />
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">

                                <!-- 拖曳握把：只有這裡會啟動拖曳，懸停會變實心 -->
                                <TextBlock Classes="grip"
                                           Text="⠿"
                                           FontSize="13"
                                           Opacity="0.45"
                                           Cursor="SizeAll"
                                           VerticalAlignment="Center"
                                           Background="Transparent"
                                           Padding="2,0"
                                           PointerPressed="OnGripPressed" />

                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding IsAvailable}"
                                          VerticalAlignment="Center" />

                                <Border Width="20" Height="20"
                                        CornerRadius="5"
                                        VerticalAlignment="Center"
                                        Background="{Binding BadgeBackground}">
                                    <Panel>
                                        <Path Data="{Binding BadgeIcon}"
                                              IsVisible="{Binding HasBadgeIcon}"
                                              Fill="{Binding BadgeForeground}"
                                              Stretch="Uniform"
                                              Width="12" Height="12"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BadgeText}"
                                                   IsVisible="{Binding !HasBadgeIcon}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding BadgeForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Panel>
                                </Border>

                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <TextBlock Classes="hint" Text="{Binding Hint}" />
                                </StackPanel>
                                </StackPanel>

                                <!-- 插入線：下面，高度 0/2 用過渡長出 -->
                                <Border Grid.Row="2"
                                        Height="{Binding InsertAfterHeight}"
                                        CornerRadius="1"
                                        Margin="26,0,2,0"
                                        Background="{Binding InsertionBrush}">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Height" Duration="0:0:0.15" />
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="風格" />
            <ItemsControl ItemsSource="{Binding ThemeOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ThemeOptionViewModel">
                        <RadioButton GroupName="theme"
                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding SelectCommand}"
                                     Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="10">

                                <!-- 預覽該風格實際的量表樣子 -->
                                <Border Width="76" Height="30"
                                        CornerRadius="5"
                                        Background="{Binding Backdrop}"
                                        Padding="6,0">
                                    <Panel VerticalAlignment="Center">
                                        <Border IsVisible="{Binding IsSmooth}"
                                                Height="5" CornerRadius="2.5"
                                                ClipToBounds="True"
                                                Background="{Binding TrackSwatch}">
                                            <Grid ColumnDefinitions="3*,2*">
                                                <Border Grid.Column="0"
                                                        CornerRadius="2.5"
                                                        Background="{Binding Swatch}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel IsVisible="{Binding IsTextStyle}"
                                                    Orientation="Horizontal"
                                                    Spacing="3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PreviewShortLabel}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding PreviewMutedBrush}" />
                                            <TextBlock Text="{Binding PreviewPercent}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding PreviewTextBrush}" />
                                        </StackPanel>
                                        <ItemsControl IsVisible="{Binding IsSegmented}"
                                                      ItemsSource="{Binding PreviewSegments}"
                                                      HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:MeterSegmentViewModel">
                                                    <Border Width="9" Height="7"
                                                            CornerRadius="{Binding Radius}"
                                                            Background="{Binding Brush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Panel>
                                </Border>

                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <TextBlock Classes="hint" Text="{Binding Description}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="開機啟動" />
            <CheckBox Content="開機時自動啟動 Manapoint"
                      IsChecked="{Binding AutoStart, Mode=TwoWay}"
                      IsVisible="{Binding IsAutoStartSupported}"
                      VerticalAlignment="Center" />
            <TextBlock Classes="hint"
                       IsVisible="{Binding IsAutoStartSupported}"
                       TextWrapping="Wrap"
                       Text="寫入你這個使用者的啟動登錄，不需管理員權限；以目前執行的這個檔案註冊。" />
            <TextBlock Text="{Binding AutoStartError}"
                       IsVisible="{Binding HasAutoStartError}"
                       FontSize="10"
                       Foreground="#C97A2E"
                       TextWrapping="Wrap" />
            <TextBlock Classes="hint"
                       IsVisible="{Binding !IsAutoStartSupported}"
                       Text="此平台不支援開機啟動。" />
        </StackPanel>

        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="section" Text="面板不透明度" />
                <TextBlock Grid.Column="1" Classes="hint" Text="{Binding OpacityText}" />
            </Grid>
            <Slider Value="{Binding PanelOpacity, Mode=TwoWay}"
                    Minimum="0.30" Maximum="1.0"
                    SmallChange="0.05" LargeChange="0.1" />
            <TextBlock IsVisible="{Binding IsBelowSafeOpacity}"
                       FontSize="10"
                       Foreground="#C97A2E"
                       TextWrapping="Wrap"
                       Text="低於 80% 之後，文字在淺色桌布上可能看不清楚。" />
        </StackPanel>

    </StackPanel>
</Window>
