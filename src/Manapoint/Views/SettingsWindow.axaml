<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Manapoint.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Manapoint.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Manapoint 設定"
        Width="330"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="18" Spacing="18">

        <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="顯示的訂閱" />
            <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProviderToggleViewModel">
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding IsAvailable}"
                                  Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="20" Height="20"
                                        CornerRadius="5"
                                        VerticalAlignment="Center"
                                        Background="{Binding BadgeBackground}">
                                    <Panel>
                                        <Path Data="{Binding BadgeIcon}"
                                              IsVisible="{Binding HasBadgeIcon}"
                                              Fill="{Binding BadgeForeground}"
                                              Stretch="Uniform"
                                              Width="12" Height="12"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BadgeText}"
                                                   IsVisible="{Binding !HasBadgeIcon}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding BadgeForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Panel>
                                </Border>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <TextBlock Classes="hint" Text="{Binding Hint}" />
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="風格" />
            <ItemsControl ItemsSource="{Binding ThemeOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ThemeOptionViewModel">
                        <RadioButton GroupName="theme"
                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding SelectCommand}"
                                     Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="10">

                                <!-- 預覽該風格實際的量表樣子 -->
                                <Border Width="76" Height="30"
                                        CornerRadius="5"
                                        Background="{Binding Backdrop}"
                                        Padding="6,0">
                                    <Panel VerticalAlignment="Center">
                                        <Border IsVisible="{Binding IsSmooth}"
                                                Height="5" CornerRadius="2.5"
                                                ClipToBounds="True"
                                                Background="{Binding TrackSwatch}">
                                            <Grid ColumnDefinitions="3*,2*">
                                                <Border Grid.Column="0"
                                                        CornerRadius="2.5"
                                                        Background="{Binding Swatch}" />
                                            </Grid>
                                        </Border>
                                        <ItemsControl IsVisible="{Binding IsSegmented}"
                                                      ItemsSource="{Binding PreviewSegments}"
                                                      HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:MeterSegmentViewModel">
                                                    <Border Width="9" Height="7"
                                                            CornerRadius="{Binding Radius}"
                                                            Background="{Binding Brush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Panel>
                                </Border>

                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <TextBlock Classes="hint" Text="{Binding Description}" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="section" Text="面板不透明度" />
                <TextBlock Grid.Column="1" Classes="hint" Text="{Binding OpacityText}" />
            </Grid>
            <Slider Value="{Binding PanelOpacity, Mode=TwoWay}"
                    Minimum="0.30" Maximum="1.0"
                    SmallChange="0.05" LargeChange="0.1" />
            <TextBlock IsVisible="{Binding IsBelowSafeOpacity}"
                       FontSize="10"
                       Foreground="#C97A2E"
                       TextWrapping="Wrap"
                       Text="低於 80% 之後，文字在淺色桌布上可能看不清楚。" />
        </StackPanel>

    </StackPanel>
</Window>
