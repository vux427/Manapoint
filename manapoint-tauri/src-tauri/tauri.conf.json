{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manapoint",
  "version": "0.1.0",
  "identifier": "com.worknite.manapoint",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "panel",
        "title": "Manapoint",
        "url": "index.html",
        "width": 252,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"]
  }
}
